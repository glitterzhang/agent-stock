# Robinhood account credentials (used in robin_stocks fallback mode)
ROBINHOOD_EMAIL=your_email@example.com
ROBINHOOD_PASSWORD=your_password
ROBINHOOD_MFA_KEY=your_totp_mfa_secret_key

# Strategy parameters
MAX_POSITION_PCT=0.05        # maximum allocation per stock as a fraction of total capital (5%)
STOP_LOSS_PCT=0.07           # stop-loss level (7%)
TAKE_PROFIT_PCT=0.20         # take-profit level (20%)
MAX_OPEN_POSITIONS=10        # maximum number of simultaneous positions
DAILY_LOSS_LIMIT_PCT=0.03    # maximum daily loss limit (3%)

# Screening criteria
MIN_MARKET_CAP=500000000     # minimum market cap $500M
MAX_PE_RATIO=25              # maximum price-to-earnings ratio
MAX_PB_RATIO=3.0             # maximum price-to-book ratio
RSI_OVERSOLD=40              # RSI oversold threshold
VOLUME_SURGE_MULTIPLIER=1.5  # volume surge multiplier

# Robinhood MCP Server
ROBINHOOD_MCP_URL=https://agent.robinhood.com/mcp/trading

# Finnhub earnings calendar (free; register at: https://finnhub.io/register)
FINNHUB_API_KEY=your_finnhub_key
